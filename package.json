{
  "name": "car-control-cockpit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:css": "node scripts/check-css-compat.mjs",
    "check:compat": "node scripts/check-compat.mjs",
    "build:cap": "node scripts/build-capacitor.mjs",
    "cap:sync": "node scripts/build-capacitor.mjs && npx cap sync android",
    "android:open": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "es-check": "^9.9.0",
    "lucide-react": "^0.546.0",
    "postcss": "^8.5.3",
    "postcss-preset-env": "^11.6.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.16.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^3.4.19",
    "terser": "^5.51.4",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
